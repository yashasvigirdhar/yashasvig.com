---
// Spotlight mosaic of client check-in excerpts, quoted without attribution.
import data from "@/data/coaching-year-one.json";
import Spotlight from "./Spotlight.astro";

// ==phrase== in the curated text marks a keyword to colour.
const segments = (text: string) => text.split(/==(.+?)==/g);
const FEATURED_AT_START = 3;
---

<Spotlight
	label="What clients wrote in their weekly check-ins"
	title="In their words"
	heading="Some excerpts from my clients' weekly check-ins, exactly as they wrote them."
	hint="Tap any card to read it."
>
	{
		data.quotes.map((q, i) => (
			<button
				type="button"
				class:list={["collage-tile", "spot-card", "quote-spot", { featured: i < FEATURED_AT_START }]}
				role="listitem"
				data-i={i}
				data-kw={(i % 4) + 1}
				style={`view-transition-name: quote-spot-${i}; view-transition-class: spot-card;`}
				aria-label="Read this excerpt"
			>
				<p>{segments(q.text).map((seg, j) => (j % 2 ? <mark class="kw">{seg}</mark> : seg))}</p>
			</button>
		))
	}
</Spotlight>
