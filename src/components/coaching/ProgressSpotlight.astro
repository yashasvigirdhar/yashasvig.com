---
// Spotlight mosaic of strength progressions as sparkline tiles: the heaviest set per logged session, from the
// first session to the heaviest since. Thumbnails show the name and a tiny line; featured cards draw the line.
import data from "@/data/coaching-year-one.json";
import Spotlight from "./Spotlight.astro";

const W = 200;
const H = 60;
const M = { t: 10, r: 30, b: 6, l: 26 };
const FEATURED_AT_START = 3;

const fmt = (n: number) => n.toLocaleString("en-GB", { maximumFractionDigits: 1 });
const parse = (iso: string) => new Date(Number(iso.slice(0, 4)), Number(iso.slice(5, 7)) - 1, Number(iso.slice(8, 10)) || 1).getTime();
const scale = ([d0, d1]: [number, number], [r0, r1]: [number, number]) => (v: number) => r0 + ((v - d0) / (d1 - d0 || 1)) * (r1 - r0);

const tiles = data.progressions.map((x) => {
	const xs = x.points.map((p) => parse(p[0] as string));
	const ys = x.points.map((p) => p[1] as number);
	const lo = Math.min(...ys), hi = Math.max(...ys), pad = Math.max((hi - lo) * 0.2, 0.5);
	const fx = scale([xs[0]!, xs[xs.length - 1]!], [M.l, W - M.r]);
	const fy = scale([lo - pad, hi + pad], [H - M.b, M.t]);
	const px = xs.map(fx), py = ys.map(fy);
	return {
		...x,
		gain: x.from > 0 ? Math.round((100 * (x.to - x.from)) / x.from) : null,
		logged: x.kind === "weight" || x.kind === "reps",
		path: px.map((v, i) => `${i ? "L" : "M"}${v.toFixed(1)} ${py[i]!.toFixed(1)}`).join(" "),
		first: { x: px[0]!, y: py[0]! },
		last: { x: px[px.length - 1]!, y: py[py.length - 1]! },
	};
});
---

<Spotlight label="Strength progressions from logged workouts" title="Strength" hint="Tap any card to see it.">
	{
		tiles.map((t, i) => (
			<button
				type="button"
				class:list={["collage-tile", "spot-card", "progress-card", { featured: i < FEATURED_AT_START }]}
				role="listitem"
				data-i={i}
				style={`view-transition-name: progress-spot-${i}; view-transition-class: spot-card;`}
				aria-label={`${t.exercise}: ${fmt(t.from)} to ${fmt(t.to)} ${t.unit}`}
			>
				<div class="ex">{t.exercise}</div>
				<div class="head">
					<span class="from">{fmt(t.from)} →</span>
					<span class="to">{fmt(t.to)}</span>
					<span class="unit">{t.unit}</span>
				</div>
				<div class="sub">{t.gain === null ? "from zero" : `+${t.gain}%`}</div>
				<svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
					<path class:list={["curve", { dashed: !t.logged }]} d={t.path} pathLength="1" />
					<circle class="dot start" r="3.5" cx={t.first.x} cy={t.first.y} />
					<circle class="dot end" r="4.5" cx={t.last.x} cy={t.last.y} />
					<text class="lbl" x={t.first.x - 6} y={t.first.y + 3.5} text-anchor="end">{fmt(t.from)}</text>
					<text class="lbl end" x={t.last.x + 7} y={t.last.y + 4}>{fmt(t.to)}</text>
				</svg>
			</button>
		))
	}
</Spotlight>
