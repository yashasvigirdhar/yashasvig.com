---
// Spotlight mosaic of strength progressions: heaviest set logged in the first session versus the heaviest since.
import data from "@/data/coaching-year-one.json";
import Spotlight from "./Spotlight.astro";

const fmt = (n: number) => n.toLocaleString("en-GB", { maximumFractionDigits: 1 });
const FEATURED_AT_START = 3;
---

<Spotlight
	label="Strength progressions from logged workouts"
	title="Strength"
	hint="Tap any card to see it."
>
	{
		data.progressions.map((x, i) => {
			const wasPct = x.to > 0 ? Math.max(0, Math.min(100, (100 * x.from) / x.to)) : 0;
			const gain = Math.round((x.to - x.from) * 10) / 10;
			return (
				<button
					type="button"
					class:list={["collage-tile", "spot-card", "progress-card", { featured: i < FEATURED_AT_START }]}
					role="listitem"
					data-i={i}
					style={`view-transition-name: progress-spot-${i}; view-transition-class: spot-card;`}
					aria-label={`${x.exercise}: ${fmt(x.from)} to ${fmt(x.to)} ${x.unit}`}
				>
					<div class="head">
						<div class="ex">{x.exercise}</div>
						<span class="gain">+{fmt(gain)} {x.unit}</span>
					</div>
					<div class="big">
						<span class="from">{fmt(x.from)}</span>
						<span class="arrow">→</span>
						<span class="to">{fmt(x.to)}</span>
						<span class="unit">{x.unit}</span>
					</div>
					<div class="track" aria-hidden="true" style={`--was:${wasPct}%`}>
						<span class="from-dot" />
						<span class="gain-line" />
						<span class="to-dot" />
					</div>
				</button>
			);
		})
	}
</Spotlight>
